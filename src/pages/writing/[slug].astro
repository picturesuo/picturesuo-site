---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { formatDate } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getCollection('writing', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Continuations of this piece, oldest first, so the page reads forward in time.
const threads = (await getCollection('threads', ({ data }) => !data.draft))
  .filter((t) => t.data.parent === entry.id)
  .sort((a, b) => a.data.addedAt.getTime() - b.data.addedAt.getTime());

const rendered = await Promise.all(
  threads.map(async (t) => ({ entry: t, Body: (await render(t)).Content }))
);

const anchor = (d: Date) => `c-${d.toISOString().slice(0, 10)}`;
const edits = [...entry.data.edits].sort((a, b) => b.date.getTime() - a.date.getTime());
const lastTouched = threads.length ? threads[threads.length - 1].data.addedAt : entry.data.publishedAt;
---

<SiteLayout title={entry.data.title} description={entry.data.summary}>
  <article class="page-shell">
    <header class="article-header">
      <p class="page-kicker">{entry.data.kind}</p>
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.summary}</p>
      <div class="entry-meta">
        <time datetime={entry.data.publishedAt.toISOString()}
          >{formatDate(entry.data.publishedAt)}</time
        >{entry.data.updatedAt && <span>Updated {formatDate(entry.data.updatedAt)}</span>}
        {
          rendered.length > 0 && (
            <span>
              {rendered.length} continuation{rendered.length === 1 ? '' : 's'} · last added{' '}
              {formatDate(lastTouched)}
            </span>
          )
        }
      </div>
    </header>
    <div class="prose"><Content /></div>

    {
      rendered.length > 0 && (
        <section class="thread">
          {rendered.map(({ entry: t, Body }) => (
            <article class="thread-part" id={anchor(t.data.addedAt)}>
              <div class="thread-rule">
                <a class="thread-date" href={`#${anchor(t.data.addedAt)}`}>
                  <time datetime={t.data.addedAt.toISOString()}>
                    Continued · {formatDate(t.data.addedAt)}
                  </time>
                </a>
              </div>
              {t.data.title && <h2>{t.data.title}</h2>}
              <div class="prose">
                <Body />
              </div>
            </article>
          ))}
        </section>
      )
    }

    {
      edits.length > 0 && (
        <section class="edits">
          <p class="section-label">Edited since publishing</p>
          <ul>
            {edits.map((e) => (
              <li>
                <time datetime={e.date.toISOString()}>{formatDate(e.date)}</time> — {e.note}
              </li>
            ))}
          </ul>
        </section>
      )
    }
    {
      entry.data.originalUrl && (
        <p class="callout">
          Originally published at <a href={entry.data.originalUrl}>picturesuo.wordpress.com</a>.
          Preserved here as part of the archive.
        </p>
      )
    }
  </article>
</SiteLayout>
