---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('art', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<SiteLayout title={entry.data.title} description={entry.data.summary} image={entry.data.image}>
  <article class="page-shell">
    <header class="article-header">
      <p class="page-kicker">{entry.data.year} · {entry.data.medium}</p><h1>
        {entry.data.title}
      </h1><p class="lede">{entry.data.summary}</p>
    </header>
    <img class="art-hero" src={entry.data.image} alt={entry.data.imageAlt} />
    <div class="prose"><Content /></div>
  </article>
</SiteLayout>

<style>
  .art-hero {
    width: min(820px, 100%);
    max-height: 900px;
    object-fit: contain;
    object-position: left center;
    margin: 0 0 42px;
    background: #171714;
  }
</style>
