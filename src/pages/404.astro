---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Not found" description="This page could not be found.">
  <div class="page-shell">
    <p class="page-kicker">404</p><h1>This shelf<br />is empty.</h1><p class="lede">
      The page may have moved, or it may not exist yet.
    </p><div class="hero-actions">
      <a class="button primary" href="/">Return home</a><a class="button" href="/archive"
        >Browse the archive</a
      >
    </div>
  </div>
</SiteLayout>
