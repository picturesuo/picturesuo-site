---
import SiteLayout from '../layouts/SiteLayout.astro';
import ActivityCalendar from '../components/ActivityCalendar.astro';
import CategoryCalendars from '../components/CategoryCalendars.astro';
import { currentCycle, progressItems, progressLegend } from '../data/progress';
const format = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<SiteLayout
  title="Progress"
  description="A small public record of goals, constraints, opportunity bets, and shipped work."
>
  <div class="page-shell">
    <header class="article-header">
      <p class="page-kicker">Public progress · {currentCycle.label}</p><h1>
        A record,<br />not a score.
      </h1><p class="lede">
        This page shows selected goals and meaningful changes. The complete daily log stays private.
      </p>
    </header>
    <section class="section">
      <div class="split">
        <div>
          <p class="section-label">Active goals</p><ol class="prose">
            {currentCycle.goals.map((goal) => <li>{goal}</li>)}
          </ol>
        </div>
        <div>
          <p class="section-label">Constraints / anti-goals</p><ul class="prose">
            {currentCycle.constraints.map((constraint) => <li>{constraint}</li>)}
          </ul>
        </div>
      </div>
      <p class="callout">
        A goal names an outcome. A constraint names what you refuse to sacrifice. An opportunity bet
        is a capped experiment with uncertain upside. “Anti-goal” is used here as a constraint—not
        as a concept from Marc Andreessen’s guide.
      </p>
    </section>
    <section class="section rule">
      <div class="section-head">
        <div class="section-label">The calendar</div><p class="section-intro muted">
          One square per day, filling from the bottom in the colours of what actually happened.
          Height is how full the day was; the bands are what it was made of. Use the chips to look
          at a single track. A slash means I broke one of my own constraints that day — drawn rather
          than coloured, so it survives every filter and cannot pass for a productive day.
        </p>
      </div>
      <ActivityCalendar start="2026-09-01" weeks={30} />
      <p class="callout">
        Colours describe where the time went, not whether the day was good. The daily card behind
        this stays private; only these counts reach the page.
      </p>
    </section>
    <section class="section rule">
      <div class="section-head">
        <div class="section-label">By category</div><p class="section-intro muted">
          The same days, one calendar per category, each in its own colour. Darker is more, zero to
          four. A dot is a day I recorded and did none of that thing; plain paper is a day with no
          entry at all. Tap any square to read it.
        </p>
      </div>
      <CategoryCalendars start="2026-09-01" weeks={30} />
    </section>
    <section class="section rule">
      <div class="section-head">
        <div class="section-label">Selected log</div><p class="section-intro muted">
          Public-safe milestones only. No real-time location, private relationship notes, health
          information, or raw journal text.
        </p>
      </div>
      <div class="progress-feed">
        {
          progressItems.toReversed().map((item) => (
            <article class="progress-item">
              <>
                <time datetime={item.date}>
                  {format.format(new Date(`${item.date}T00:00:00Z`))}
                </time>
                <span class:list={['kind', item.kind]}>{item.kind}</span>
                <p>{item.href ? <a href={item.href}>{item.label}</a> : item.label}</p>
              </>
            </article>
          ))
        }
      </div>
    </section>
  </div>
</SiteLayout>
