---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Picturesuo — Writing, projects, and objects',
  description = 'A growing record of writing, technical projects, ceramics, and field notes.',
  image = '/images/site/social-card.png',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title === 'Picturesuo' ? title : `${title} — Picturesuo`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f0e8" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Picturesuo" href="/rss.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Picturesuo — writing, projects, art, and progress." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />
    <title>{pageTitle}</title>
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Picturesuo home">Picturesuo<span>.</span></a>
      <nav aria-label="Primary navigation">
        <a href="/writing">Writing</a>
        <a href="/projects">Projects</a>
        <a href="/art">Art</a>
        <a href="/now">Now</a>
        <a href="/progress">Progress</a>
        <a href="/archive">Archive</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div>
        <strong>Picturesuo</strong>
        <p>A durable record of things made, learned, and noticed.</p>
      </div>
      <div class="footer-links">
        <a href="https://x.com/picturesuo" rel="me">X</a>
        <a href="https://github.com/picturesuo" rel="me">GitHub</a>
        <a href="/rss.xml">RSS</a>
        <a href="/about">About</a>
      </div>
    </footer>
  </body>
</html>
