---
/**
 * ClayHero — the signature hero object.
 *
 * Static-first: the default DOM is a real photograph of a hand-thrown vessel,
 * so no-JS, reduced-motion, and no-WebGL visitors see a finished object with no
 * layout shift. three.js only *enhances* — and only when it is both safe
 * (WebGL available, motion allowed) and worth it (the hero has scrolled into
 * view). When it boots, a procedural lathe-turned pot replaces the photo on a
 * transparent canvas so the paper shows through, and you can spin it.
 *
 * three is pulled in with a dynamic import() so its chunk is never on the
 * critical path and never inlined into the (staticrypt-encrypted) HTML.
 */
---

<div class="clay-stage" data-clay-stage>
  <span class="clay-shadow" aria-hidden="true"></span>
  <img
    class="clay-fallback"
    src="/images/art/clay-figure.jpeg"
    alt="A hand-thrown stoneware vessel, matte and unglazed, on warm paper."
    loading="eager"
    decoding="async"
    width="640"
    height="640"
  />
  <canvas class="clay-canvas" data-clay-canvas aria-hidden="true"></canvas>
  <p class="clay-hint" aria-hidden="true">Drag to turn</p>
</div>

<script>
  import { buildPotGeometry } from '../lib/studio/pots';

  type ThreeModule = typeof import('three');

  function hasWebGL(): boolean {
    try {
      const c = document.createElement('canvas');
      return !!(
        window.WebGLRenderingContext &&
        (c.getContext('webgl') || c.getContext('experimental-webgl'))
      );
    } catch {
      return false;
    }
  }

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-clay-stage]').forEach((stage) => {
    const canvas = stage.querySelector<HTMLCanvasElement>('[data-clay-canvas]');
    if (!canvas) return;

    let booted = false;

    // Boot only when the hero is on screen, motion is allowed, and WebGL exists.
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting && !booted && !reduceMotion.matches && hasWebGL()) {
            booted = true;
            io.disconnect();
            boot(stage, canvas).catch(() => {
              // Anything goes wrong booting three: keep the static photo.
              stage.classList.remove('is-live');
            });
          }
        }
      },
      { rootMargin: '200px' },
    );
    io.observe(stage);
  });

  async function boot(stage: HTMLElement, canvas: HTMLCanvasElement) {
    const THREE: ThreeModule = await import('three');

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
      powerPreference: 'high-performance',
    });
    renderer.setPixelRatio(Math.min(2, window.devicePixelRatio || 1));
    renderer.setClearAlpha(0);

    const scene = new THREE.Scene();

    const camera = new THREE.PerspectiveCamera(35, 1, 0.1, 100);
    camera.position.set(0, 0.85, 5.2);
    camera.lookAt(0, -0.05, 0);

    // --- The vessel -------------------------------------------------------
    // A hand-tuned thrown-pot silhouette: narrow foot, rounded belly, a neck
    // that draws in, and a subtly flared lip — with gentle N-lobed fluting so
    // the rotation reads. The profile and fluting live in the shared studio
    // pot generator (defaults are this hero silhouette).
    const geometry = buildPotGeometry(THREE);

    const material = new THREE.MeshStandardMaterial({
      color: new THREE.Color('#c46a50'), // unglazed stoneware, from the coral family
      roughness: 0.86,
      metalness: 0.0,
      side: THREE.DoubleSide, // the open mouth shows a lit interior wall
    });

    const pot = new THREE.Mesh(geometry, material);
    const group = new THREE.Group();
    group.add(pot);
    scene.add(group);

    // --- Studio light on paper -------------------------------------------
    const hemi = new THREE.HemisphereLight(0xf3f0e8, 0x5a4636, 0.95);
    scene.add(hemi);

    const key = new THREE.DirectionalLight(0xfff2e2, 1.15);
    key.position.set(-3.2, 4.5, 3.4);
    scene.add(key);

    const fill = new THREE.DirectionalLight(0xcfe4ef, 0.32);
    fill.position.set(3.5, 1.2, 2.0);
    scene.add(fill);

    const rim = new THREE.DirectionalLight(0xffffff, 0.22);
    rim.position.set(0.5, 2.0, -3.5);
    scene.add(rim);

    // --- Sizing -----------------------------------------------------------
    function resize() {
      const w = stage.clientWidth || 1;
      const h = stage.clientHeight || 1;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    }
    resize();
    const ro = new ResizeObserver(resize);
    ro.observe(stage);

    // --- Interaction: drag to spin, inertia, gentle auto-rotate ----------
    const AUTO = 0.3; // rad/s
    let velocity = 0; // user-imparted angular velocity (rad/s)
    let dragging = false;
    let lastX = 0;
    let lastMove = 0;

    function onDown(e: PointerEvent) {
      dragging = true;
      velocity = 0;
      lastX = e.clientX;
      lastMove = performance.now();
      stage.classList.add('is-grabbing');
      canvas.setPointerCapture(e.pointerId);
    }
    function onMove(e: PointerEvent) {
      if (!dragging) return;
      const now = performance.now();
      const dx = e.clientX - lastX;
      lastX = e.clientX;
      const dt = Math.max((now - lastMove) / 1000, 0.001);
      lastMove = now;
      const delta = dx * 0.01;
      group.rotation.y += delta;
      // Derive an angular velocity for release inertia, clamped so a hard
      // flick cannot send it spinning wildly.
      velocity = Math.max(-6, Math.min(6, delta / dt));
    }
    function onUp(e: PointerEvent) {
      if (!dragging) return;
      dragging = false;
      stage.classList.remove('is-grabbing');
      try {
        canvas.releasePointerCapture(e.pointerId);
      } catch {
        /* pointer already released */
      }
    }
    canvas.addEventListener('pointerdown', onDown);
    canvas.addEventListener('pointermove', onMove);
    canvas.addEventListener('pointerup', onUp);
    canvas.addEventListener('pointercancel', onUp);
    canvas.addEventListener('lostpointercapture', () => {
      dragging = false;
      stage.classList.remove('is-grabbing');
    });

    // --- Render loop, paused when off-screen or tab hidden ----------------
    let raf = 0;
    let running = false;
    let last = performance.now();

    function tick(now: number) {
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      if (!dragging) {
        group.rotation.y += (AUTO + velocity) * dt;
        // Frame-rate independent decay of the flick's inertia.
        velocity *= Math.pow(0.12, dt);
      }
      pot.position.y = Math.sin(now * 0.0009) * 0.03; // subtle idle bob
      renderer.render(scene, camera);
      raf = requestAnimationFrame(tick);
    }
    function start() {
      if (running) return;
      running = true;
      last = performance.now();
      raf = requestAnimationFrame(tick);
    }
    function stop() {
      running = false;
      cancelAnimationFrame(raf);
    }

    // Reveal the live canvas, retire the photo.
    stage.classList.add('is-live');

    // Pause when the hero scrolls away; resume when it returns.
    let onScreen = false;
    const vis = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          onScreen = e.isIntersecting;
          if (onScreen && !document.hidden) start();
          else stop();
        }
      },
      { threshold: 0.01 },
    );
    vis.observe(stage);

    // Refocusing the tab only resumes if the hero is actually on screen.
    document.addEventListener('visibilitychange', () => {
      if (document.hidden || !onScreen) stop();
      else start();
    });

    // If a visitor flips reduced-motion on after boot, fall back to the photo.
    reduceMotion.addEventListener('change', (e) => {
      if (!e.matches) return;
      stop();
      stage.classList.remove('is-live');
    });

    start();
  }
</script>

<style>
  .clay-stage {
    position: relative;
    width: 100%;
    max-width: 460px;
    margin-inline: auto;
    aspect-ratio: 1 / 1;
    isolation: isolate;
  }

  .clay-fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 10px;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.5),
      0 22px 48px -26px rgba(23, 23, 20, 0.6);
    filter: saturate(0.94);
  }

  .clay-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: none;
    cursor: grab;
    touch-action: pan-y; /* vertical page scroll still works over the pot */
  }
  .clay-stage.is-grabbing .clay-canvas {
    cursor: grabbing;
  }

  /* Soft contact shadow drawn in CSS, so the renderer needs no shadow map. */
  .clay-shadow {
    position: absolute;
    left: 50%;
    bottom: 7%;
    width: 58%;
    height: 9%;
    transform: translateX(-50%);
    background: radial-gradient(
      ellipse at center,
      rgba(23, 23, 20, 0.26),
      rgba(23, 23, 20, 0) 70%
    );
    opacity: 0;
    transition: opacity 0.6s ease;
    pointer-events: none;
    z-index: -1;
  }

  .clay-hint {
    position: absolute;
    left: 50%;
    bottom: -1.7rem;
    transform: translateX(-50%);
    margin: 0;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    opacity: 0;
    transition: opacity 0.6s ease;
    pointer-events: none;
  }

  /* Once three.js is live: show the canvas + its shadow, retire the photo. */
  .clay-stage.is-live .clay-canvas {
    display: block;
  }
  .clay-stage.is-live .clay-fallback {
    display: none;
  }
  .clay-stage.is-live .clay-shadow,
  .clay-stage.is-live .clay-hint {
    opacity: 1;
  }

  @media (max-width: 850px) {
    .clay-stage {
      max-width: 360px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* Never enhance under reduced motion: the photo is the object. */
    .clay-canvas {
      display: none !important;
    }
    .clay-shadow,
    .clay-hint {
      opacity: 0 !important;
    }
  }
</style>
